{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-globals": [
      "error",
      { "name": "fetch", "message": "Network calls belong in src/google. Use its exports from src/google/index.ts." },
      { "name": "XMLHttpRequest", "message": "Network calls belong in src/google." },
      { "name": "WebSocket", "message": "Network calls belong in src/google." },
      { "name": "EventSource", "message": "Network calls belong in src/google." },
      { "name": "google", "message": "Google's scripts are only used in src/google." },
      { "name": "gapi", "message": "Google's scripts are only used in src/google." }
    ],
    "no-restricted-properties": [
      "error",
      { "object": "window", "property": "fetch", "message": "Network calls belong in src/google." },
      { "object": "globalThis", "property": "fetch", "message": "Network calls belong in src/google." }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/google/*", "!**/google/index.ts"],
            "message": "Outside src/google, import Google access only from src/google/index.ts."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/google/**"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off",
        "no-restricted-imports": "off"
      }
    }
  ]
}
